{
  "name": "agrimanage",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@agrimanage/web",
    "dev:api": "turbo run dev --filter=@agrimanage/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@agrimanage/database",
    "db:migrate": "turbo run db:migrate --filter=@agrimanage/database",
    "db:studio": "pnpm --filter @agrimanage/database studio",
    "db:seed": "pnpm --filter @agrimanage/database db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
